function(mspm0_add_driverlib_modules target_name)
    if(NOT TARGET "${target_name}")
        message(FATAL_ERROR "Unknown DriverLib target: ${target_name}")
    endif()

    foreach(module_name IN LISTS ARGN)
        if(module_name STREQUAL "common")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_common.c")
        elseif(module_name STREQUAL "timer")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_timer.c")
        elseif(module_name STREQUAL "gpio")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_gpio.c")
        elseif(module_name STREQUAL "factoryregion")
            set(module_source
                "${SDK_SOURCE}/ti/driverlib/m0p/dl_factoryregion.c")
        elseif(module_name STREQUAL "sysctl")
            if(MSPM0_DEVICE STREQUAL "MSPM0G3507")
                set(module_source
                    "${SDK_SOURCE}/ti/driverlib/m0p/sysctl/dl_sysctl_mspm0g1x0x_g3x0x.c")
            elseif(MSPM0_DEVICE STREQUAL "MSPM0G3519")
                set(module_source
                    "${SDK_SOURCE}/ti/driverlib/m0p/sysctl/dl_sysctl_mspm0gx51x.c")
            else()
                message(FATAL_ERROR
                    "No SysCtl module mapping for ${MSPM0_DEVICE}")
            endif()
        elseif(module_name STREQUAL "uart")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_uart.c")
        elseif(module_name STREQUAL "spi")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_spi.c")
        elseif(module_name STREQUAL "i2c")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_i2c.c")
        elseif(module_name STREQUAL "dma")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_dma.c")
        elseif(module_name STREQUAL "adc12")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_adc12.c")
        elseif(module_name STREQUAL "flashctl")
            set(module_source "${SDK_SOURCE}/ti/driverlib/dl_flashctl.c")
        else()
            message(FATAL_ERROR
                "Unknown DriverLib module '${module_name}'")
        endif()

        if(NOT EXISTS "${module_source}")
            message(FATAL_ERROR
                "DriverLib source is missing: ${module_source}")
        endif()

        get_target_property(existing_sources "${target_name}" SOURCES)
        if(NOT existing_sources)
            set(existing_sources "")
        endif()
        list(FIND existing_sources "${module_source}" source_index)
        if(source_index EQUAL -1)
            target_sources("${target_name}" PRIVATE "${module_source}")
        endif()
    endforeach()
endfunction()
