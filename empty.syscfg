GPIO6.$name                   = "BIN2";
GPIO6.associatedPins[0].$name = "PIN_3";
GPIO6.associatedPins[0].pin.$assign = "PA27";

GPIO7.$name                   = "STBY";
GPIO7.associatedPins[0].$name = "PIN_STBY";
GPIO7.associatedPins[0].pin.$assign = "PB0";

GPIO8.$name                   = "GPIO_BUZZER";
GPIO8.associatedPins[0].$name = "PIN_BUZZER";
GPIO8.associatedPins[0].pin.$assign = "PA0";

PWM1.$name                      = "PWM_0";
PWM1.peripheral.ccp0Pin.$assign = "PC2";
PWM1.peripheral.ccp1Pin.$assign = "PC4";
PWM1.PWM_CHANNEL_0.$name        = "ti_driverlib_pwm_PWMTimerCC0";
PWM1.PWM_CHANNEL_1.$name        = "ti_driverlib_pwm_PWMTimerCC1";
PWM1.ccp0PinConfig.$name        = "ti_driverlib_gpio_GPIOPinGeneric6";
PWM1.ccp1PinConfig.$name        = "ti_driverlib_gpio_GPIOPinGeneric7";

QEI1.$name                              = "QEI_Left";
QEI1.peripheral.$assign                 = "TIMG9";
QEI1.peripheral.ccp0Pin.$assign         = "PB29";
QEI1.peripheral.ccp1Pin.$assign         = "PB30";
QEI1.ccp0PinConfig.$name                = "ti_driverlib_gpio_GPIOPinGeneric2";
QEI1.ccp0PinConfig.hideOutputInversion  = scripting.forceWrite(false);
QEI1.ccp0PinConfig.onlyInternalResistor = scripting.forceWrite(false);
QEI1.ccp0PinConfig.passedPeripheralType = scripting.forceWrite("Digital");
QEI1.ccp0PinConfig.internalResistor     = "PULL_UP";
QEI1.ccp1PinConfig.$name                = "ti_driverlib_gpio_GPIOPinGeneric3";
QEI1.ccp1PinConfig.hideOutputInversion  = scripting.forceWrite(false);
QEI1.ccp1PinConfig.onlyInternalResistor = scripting.forceWrite(false);
QEI1.ccp1PinConfig.passedPeripheralType = scripting.forceWrite("Digital");
QEI1.ccp1PinConfig.internalResistor     = "PULL_UP";

QEI2.$name                              = "QEI_Right";
QEI2.peripheral.ccp0Pin.$assign         = "PB6";
QEI2.peripheral.ccp1Pin.$assign         = "PB7";
QEI2.ccp0PinConfig.$name                = "ti_driverlib_gpio_GPIOPinGeneric4";
